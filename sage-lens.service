[Unit]
Description=Sage Lens — AI Search Agent
After=network.target

[Service]
Type=simple
ExecStart=/root/projects/mini-search-agent/venv/bin/python3 /root/projects/mini-search-agent/bot.py
WorkingDirectory=/root/projects/mini-search-agent
Restart=on-failure
RestartSec=5
EnvironmentFile=/root/projects/mini-search-agent/.env
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
