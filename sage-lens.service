[Unit]
Description=Sage Lens — AI Search Agent for Telegram
After=network.target

[Service]
Type=simple
ExecStart=/root/projects/sage-lens/venv/bin/python3 /root/projects/sage-lens/bot.py
WorkingDirectory=/root/projects/sage-lens
Restart=on-failure
RestartSec=5
EnvironmentFile=/root/projects/sage-lens/.env
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
