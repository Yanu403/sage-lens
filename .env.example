# Telegram
TELEGRAM_BOT_TOKEN=your_bot_token_here

# Bot Mode: "polling" (default) or "webhook"
BOT_MODE=polling
# WEBHOOK_URL=https://your-domain.com
# WEBHOOK_PORT=8443

# LLM — Intent Router (Gemma via Gemini API)
GEMINI_API_KEY=your_gemini_api_key
GEMINI_MODEL=gemma-4-26b-a4b-it
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai

# LLM — Synthesis (provider-agnostic, OpenAI-compatible)
# Works with MiMo, GPT, DeepSeek, Kimi, Claude (via OpenRouter), Gemini, etc.
SYNTHESIS_API_KEY=your_api_key
SYNTHESIS_MODEL=mimo-v2.5-pro
SYNTHESIS_BASE_URL=https://token-plan-sgp.xiaomimimo.com/v1

# ── Provider Examples ──
# MiMo:      SYNTHESIS_BASE_URL=https://token-plan-sgp.xiaomimimo.com/v1
# GPT:       SYNTHESIS_BASE_URL=https://api.openai.com/v1
# DeepSeek:  SYNTHESIS_BASE_URL=https://api.deepseek.com/v1
# Kimi:      SYNTHESIS_BASE_URL=https://api.moonshot.cn/v1
# Claude:    SYNTHESIS_BASE_URL=https://openrouter.ai/api/v1
# Gemini:    SYNTHESIS_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai

# Search
TAVILY_API_KEY=your_tavily_api_key

# Limits
RATE_LIMIT_PER_HOUR=20
CACHE_TTL_HOURS=6
MAX_SOURCES=5
MAX_CONTEXT_CHARS=8000

# Conversation Memory
CONVERSATION_MAX_HISTORY=10
CONVERSATION_TTL_SECONDS=600
